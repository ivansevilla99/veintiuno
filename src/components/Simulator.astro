---
import { packs } from '../i18n';
import { campaignURL } from '../lib/site';
interface Props { lang?: 'es' | 'en' | 'de' | 'fr' }
const { lang = 'es' } = Astro.props;
const appLink = campaignURL(`${lang}-simulator`);
const T = ({
  es: { aria: 'Mesa de blackjack para practicar', table: 'Mesa', spain: 'Casino en España', s17: 'Las Vegas (S17)', h17: 'Las Vegas (H17)', eu: 'Europea / online', accT: 'Decisiones correctas', acc: 'aciertos', strT: 'Racha de decisiones correctas', str: 'racha', reset: 'Poner a cero', dealer: 'Crupier',
        hit: 'Pedir', stand: 'Plantarse', double: 'Doblar', split: 'Dividir', surrender: 'Rendirse', deal: 'Repartir', space: 'Espacio', keys: ['P', 'S', 'D', 'V', 'R'],
        nudge1: 'Llevas', nudge2: 'manos.', nudge3: 'En la app de Veintiuno tienes el curso de 14 días, el mapa de calor con las casillas que más fallas y el consultor de manos.', see: 'Ver la app →' },
  en: { aria: 'Blackjack practice table', table: 'Table', spain: 'Spanish casino', s17: 'Las Vegas (S17)', h17: 'Las Vegas (H17)', eu: 'European / online', accT: 'Correct decisions', acc: 'correct', strT: 'Streak of correct decisions', str: 'streak', reset: 'Reset', dealer: 'Dealer',
        hit: 'Hit', stand: 'Stand', double: 'Double', split: 'Split', surrender: 'Surrender', deal: 'Deal', space: 'Space', keys: ['H', 'S', 'D', 'P', 'R'],
        nudge1: 'You’ve played', nudge2: 'hands.', nudge3: 'The Veintiuno app adds the 14-day course, a heat map of the chart cells you miss most, and the hand consultant.', see: 'See the app →' },
  de: { aria: 'Blackjack-Übungstisch', table: 'Tisch', spain: 'Spanisches Casino', s17: 'Las Vegas (S17)', h17: 'Las Vegas (H17)', eu: 'Europäisch / online', accT: 'Richtige Entscheidungen', acc: 'richtig', strT: 'Serie richtiger Entscheidungen', str: 'Serie', reset: 'Zurücksetzen', dealer: 'Dealer',
        hit: 'Ziehen', stand: 'Stehen', double: 'Verdoppeln', split: 'Splitten', surrender: 'Aufgeben', deal: 'Austeilen', space: 'Leertaste', keys: ['H', 'S', 'D', 'P', 'R'],
        nudge1: 'Du hast', nudge2: 'Hände gespielt.', nudge3: 'Die Veintiuno-App bietet dazu den 14-Tage-Kurs, eine Heatmap der Felder, die du am häufigsten falsch spielst, und den Hand-Berater.', see: 'Zur App →' },
  fr: { aria: 'Table d’entraînement au blackjack', table: 'Table', spain: 'Casino espagnol', s17: 'Las Vegas (S17)', h17: 'Las Vegas (H17)', eu: 'Européenne / en ligne', accT: 'Décisions correctes', acc: 'de réussite', strT: 'Série de décisions correctes', str: 'série', reset: 'Remettre à zéro', dealer: 'Croupier',
        hit: 'Tirer', stand: 'Rester', double: 'Doubler', split: 'Séparer', surrender: 'Abandonner', deal: 'Distribuer', space: 'Espace', keys: ['T', 'R', 'D', 'S', 'A'],
        nudge1: 'Vous avez joué', nudge2: 'mains.', nudge3: 'L’app Veintiuno ajoute le cours de 14 jours, une carte des cases où vous vous trompez le plus et le conseiller de mains.', see: 'Voir l’app →' },
} as Record<string, any>)[lang] ?? packs[lang]!.simT;
// Texts the table needs while playing (read by the script below).
const W = ({
  es: { name: { hit: 'pedir', stand: 'plantarse', double: 'doblar', split: 'dividir', surrender: 'rendirse' }, res: { blackjack: '¡Blackjack!', win: 'Ganas', push: 'Empate', lose: 'Pierdes', bust: 'Te pasas', surrender: 'Te rindes' },
        hidden: 'Carta oculta', bj: 'Blackjack', bust: 'se pasa', doubled: 'doblada', of: 'de', won: 'ganadas', good: 'Bien', was: 'La jugada era', pct: ' %', rules: 'spainCasino', keys: { p: 'hit', h: 'hit', s: 'stand', d: 'double', v: 'split', r: 'surrender' } },
  en: { name: { hit: 'hit', stand: 'stand', double: 'double', split: 'split', surrender: 'surrender' }, res: { blackjack: 'Blackjack!', win: 'You win', push: 'Push', lose: 'You lose', bust: 'Bust', surrender: 'Surrendered' },
        hidden: 'Hole card', bj: 'Blackjack', bust: 'bust', doubled: 'doubled', of: 'of', won: 'won', good: 'Good', was: 'The right play was', pct: '%', rules: 'vegasS17', keys: { h: 'hit', s: 'stand', d: 'double', p: 'split', r: 'surrender' } },
  de: { name: { hit: 'ziehen', stand: 'stehen bleiben', double: 'verdoppeln', split: 'splitten', surrender: 'aufgeben' }, res: { blackjack: 'Blackjack!', win: 'Gewonnen', push: 'Unentschieden', lose: 'Verloren', bust: 'Überkauft', surrender: 'Aufgegeben' },
        hidden: 'Verdeckte Karte', bj: 'Blackjack', bust: 'überkauft', doubled: 'verdoppelt', of: 'von', won: 'gewonnen', good: 'Richtig', was: 'Richtig wäre:', pct: ' %', rules: 'europeanOnline', keys: { h: 'hit', s: 'stand', d: 'double', p: 'split', r: 'surrender' } },
  fr: { name: { hit: 'tirer', stand: 'rester', double: 'doubler', split: 'séparer', surrender: 'abandonner' }, res: { blackjack: 'Blackjack !', win: 'Gagné', push: 'Égalité', lose: 'Perdu', bust: 'Vous sautez', surrender: 'Abandon' },
        hidden: 'Carte cachée', bj: 'Blackjack', bust: 'saute', doubled: 'doublée', of: 'sur', won: 'gagnées', good: 'Bien', was: 'Il fallait', pct: ' %', rules: 'europeanOnline', keys: { t: 'hit', r: 'stand', d: 'double', s: 'split', a: 'surrender' } },
} as Record<string, any>)[lang] ?? packs[lang]!.simW;
---
<section class="sim" data-sim data-lang={lang} data-w={JSON.stringify(W)} aria-label={T.aria}>
  <div class="sim-top">
    <label class="sim-rules">{T.table}
      <select data-rules>
        <option value="spainCasino">{T.spain}</option>
        <option value="vegasS17">{T.s17}</option>
        <option value="vegasH17">{T.h17}</option>
        <option value="europeanOnline">{T.eu}</option>
      </select>
    </label>
    <div class="sim-stats" aria-live="polite">
      <span title={T.accT}><b data-acc>—</b> {T.acc}</span>
      <span title={T.strT}><b data-streak>0</b> {T.str}</span>
      <button type="button" class="sim-reset" data-reset title={T.reset}>↺</button>
    </div>
  </div>

  <div class="felt">
    <div class="row dealer">
      <span class="lbl">{T.dealer} <em data-dtotal></em></span>
      <div class="cards" data-dealer></div>
    </div>
    <div class="result" data-result aria-live="polite"></div>
    <div class="row player" data-player></div>
  </div>

  <div class="feedback" data-feedback aria-live="polite" hidden></div>

  <div class="actions" data-actions>
    <button type="button" data-a="hit">{T.hit} <kbd>{T.keys[0]}</kbd></button>
    <button type="button" data-a="stand">{T.stand} <kbd>{T.keys[1]}</kbd></button>
    <button type="button" data-a="double">{T.double} <kbd>{T.keys[2]}</kbd></button>
    <button type="button" data-a="split">{T.split} <kbd>{T.keys[3]}</kbd></button>
    <button type="button" data-a="surrender">{T.surrender} <kbd>{T.keys[4]}</kbd></button>
  </div>
  <button type="button" class="deal btn btn-gold" data-deal>{T.deal} <kbd>{T.space}</kbd></button>

  <aside class="sim-nudge" data-nudge hidden>
    <b>{T.nudge1} <span data-nhands>20</span> {T.nudge2}</b> {T.nudge3}
    <a href={appLink} rel="noopener">{T.see}</a>
  </aside>
</section>

<style is:global>
  .sim { margin: 24px 0 8px; }
  .sim-top { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .sim-rules { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 14px; }
  .sim-rules select { font: inherit; font-size: 15px; color: var(--text); background: var(--panel-2); border: 1px solid var(--line-strong); border-radius: 12px; padding: 8px 10px; }
  .sim-stats { display: flex; gap: 16px; align-items: center; font-size: 14px; color: var(--muted); }
  .sim-stats b { color: var(--gold); font-size: 17px; margin-right: 4px; font-variant-numeric: tabular-nums; }
  .sim-reset { background: none; border: 1px solid var(--line-strong); color: var(--muted); border-radius: 99px; width: 30px; height: 30px; cursor: pointer; }
  .felt { position: relative; border-radius: 28px; padding: 22px 18px 26px; min-height: 380px; display: grid; grid-template-rows: auto 1fr auto; gap: 8px;
    background: radial-gradient(900px 420px at 50% 0%, #11574a, var(--felt-deep) 70%); border: 1px solid rgba(237,194,92,.25); box-shadow: inset 0 0 60px rgba(0,0,0,.35); }
  .row { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .lbl { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.55); font-weight: 700; }
  .lbl em { font-style: normal; color: var(--text); margin-left: 6px; letter-spacing: 0; }
  .cards { display: flex; min-height: 112px; }
  .card-el { width: 76px; height: 108px; border-radius: 10px; background: var(--card); color: var(--card-ink); position: relative; margin-left: -26px; box-shadow: 0 8px 22px rgba(0,0,0,.4); font-family: var(--font-display); animation: dealin .28s cubic-bezier(.2,.8,.2,1) both; }
  .card-el:first-child { margin-left: 0; }
  .card-el.red { color: var(--red); }
  .card-el .c { position: absolute; top: 6px; left: 8px; font-weight: 800; font-size: 20px; line-height: 1; text-align: center; }
  .card-el .c i { display: block; font-style: normal; font-size: 16px; }
  .card-el .p { position: absolute; right: 8px; bottom: 6px; font-size: 34px; line-height: 1; }
  .card-el.back { background: repeating-linear-gradient(45deg, #8c1f29 0 7px, #7a1a23 7px 14px); border: 5px solid var(--card); }
  @keyframes dealin { from { opacity: 0; transform: translate(40px, -60px) rotate(8deg); } }
  .result { align-self: center; text-align: center; font: 800 30px/1.1 var(--font-display); min-height: 36px; }
  .result.win { color: var(--correct); } .result.lose { color: var(--wrong); } .result.push { color: var(--text-2); }
  .player { flex-direction: row; justify-content: center; gap: 22px; flex-wrap: wrap; }
  .phand { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 8px; border-radius: 16px; border: 2px solid transparent; }
  .phand.active { border-color: rgba(237,194,92,.7); background: rgba(237,194,92,.06); }
  .phand .tot { font-size: 13px; font-weight: 700; color: var(--text); background: rgba(0,0,0,.35); padding: 3px 10px; border-radius: 99px; }
  .phand .tot.bad { color: var(--wrong); } .phand .tot.good { color: var(--correct); }
  .feedback { margin: 12px 0 0; padding: 12px 16px; border-radius: 14px; font-size: 15px; }
  .feedback.ok { background: rgba(92,214,140,.1); border: 1px solid rgba(92,214,140,.4); color: var(--text-2); }
  .feedback.ko { background: rgba(242,97,92,.1); border: 1px solid rgba(242,97,92,.5); color: var(--text); }
  .feedback b { display: block; margin-bottom: 2px; }
  .feedback.ok b { color: var(--correct); } .feedback.ko b { color: var(--wrong); }
  .actions { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 12px; }
  .actions button { font: 700 15px/1.1 var(--font); padding: 14px 6px; border-radius: 14px; border: 1px solid var(--line-strong); background: var(--panel-2); color: var(--text); cursor: pointer; }
  .actions button:hover:not(:disabled) { border-color: var(--gold); }
  .actions button:disabled { opacity: .3; cursor: default; }
  kbd { display: inline-block; font: 600 11px/1 var(--font); color: var(--muted); border: 1px solid var(--line-strong); border-radius: 5px; padding: 2px 5px; margin-left: 4px; vertical-align: middle; }
  .deal { width: 100%; margin-top: 10px; }
  .deal kbd { color: #5a4613; border-color: rgba(0,0,0,.25); }
  .sim-nudge { margin-top: 14px; padding: 14px 16px; border-radius: 14px; background: linear-gradient(135deg, rgba(237,194,92,.14), rgba(237,194,92,.04)); border: 1px solid rgba(237,194,92,.35); font-size: 15px; color: var(--text-2); }
  .sim-nudge a { font-weight: 700; margin-left: 4px; }
  @media (max-width: 560px) {
    .actions { grid-template-columns: repeat(3, 1fr); }
    kbd { display: none; }
    .card-el { width: 62px; height: 88px; margin-left: -22px; } .card-el .p { font-size: 26px; } .card-el .c { font-size: 17px; }
    .felt { min-height: 340px; padding: 18px 10px 20px; }
  }
</style>

<script>
  import { presets, type Action, type Rules } from '../lib/strategy';
  import { explain } from '../lib/explain';
  import { Shoe, Round, total, isBlackjack, type Card, type Outcome } from '../lib/game';

  const root = document.querySelector<HTMLElement>('[data-sim]')!;
  const LANG = (root.dataset.lang ?? 'es') as 'es' | 'en' | 'de' | 'fr';
  const W = JSON.parse(root.dataset.w!) as { name: Record<Action, string>; res: Record<Outcome, string>; hidden: string; bj: string; bust: string; doubled: string; of: string; won: string; good: string; was: string; pct: string; rules: string; keys: Record<string, Action> };
  const NAME = W.name;
  const KEYS = W.keys;
  const KIND: Record<Outcome, string> = { blackjack: 'win', win: 'win', push: 'push', lose: 'lose', bust: 'lose', surrender: 'push' };
  const RESULT: Record<Outcome, [string, string]> = Object.fromEntries((Object.keys(KIND) as Outcome[]).map((o) => [o, [W.res[o], KIND[o]]])) as Record<Outcome, [string, string]>;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const store = {
    get(k: string, d: number) { try { return Number(localStorage.getItem(`vt-sim-${k}`) ?? d); } catch { return d; } },
    set(k: string, v: number | string) { try { localStorage.setItem(`vt-sim-${k}`, String(v)); } catch {} },
    getS(k: string) { try { return localStorage.getItem(`vt-sim-${k}`); } catch { return null; } },
  };

  const DEFAULT = W.rules;
  let rulesKey = store.getS('rules') ?? DEFAULT;
  if (!presets[rulesKey]) rulesKey = DEFAULT;
  let rules: Rules = presets[rulesKey];
  let shoe = new Shoe(rules.decks);
  let round: Round | null = null;
  let right = store.get('right', 0), total_ = store.get('total', 0), streak = store.get('streak', 0), hands = store.get('hands', 0);
  let nudged = false;

  $<HTMLSelectElement>('[data-rules]').value = rulesKey;

  const cardHTML = (c: Card | null) => {
    if (!c) return `<div class="card-el back" aria-label="${W.hidden}"></div>`;
    const red = c.suit === '♥' || c.suit === '♦';
    return `<div class="card-el${red ? ' red' : ''}" aria-label="${c.rank}${c.suit}"><span class="c">${c.rank}<i>${c.suit}</i></span><span class="p">${c.suit}</span></div>`;
  };

  function stats() {
    $('[data-acc]').textContent = total_ ? `${Math.round((100 * right) / total_)}${W.pct}` : '—';
    $('[data-streak]').textContent = String(streak);
  }

  function render() {
    const dealerEl = $('[data-dealer]'), playerEl = $('[data-player]');
    if (!round) { dealerEl.innerHTML = ''; playerEl.innerHTML = ''; $('[data-dtotal]').textContent = ''; }
    else {
      const showAll = round.finished;
      const dcards: (Card | null)[] = showAll ? round.dealer : [round.dealer[0], ...(rules.holeCard ? [null] : [])];
      dealerEl.innerHTML = dcards.map(cardHTML).join('');
      const dt = total(showAll ? round.dealer : [round.dealer[0]]);
      $('[data-dtotal]').textContent = showAll && isBlackjack(round.dealer) ? W.bj : dt.total > 21 ? `${dt.total} · ${W.bust}` : `${dt.soft && dt.total < 21 ? dt.total - 10 + '/' : ''}${dt.total}`;
      playerEl.innerHTML = round.player.map((h, i) => {
        const t = total(h.cards);
        const label = isBlackjack(h.cards) && round!.player.length === 1 ? W.bj : t.total > 21 ? (round!.finished ? `${t.total}` : `${t.total} · ${W.bust}`) : `${t.soft && t.total < 21 ? t.total - 10 + '/' : ''}${t.total}`;
        const out = round!.finished ? round!.outcomes[i] : null;
        const cls = out ? (RESULT[out][1] === 'win' ? 'good' : RESULT[out][1] === 'lose' ? 'bad' : '') : '';
        const active = !round!.finished && i === round!.active && round!.player.length > 1 ? ' active' : '';
        return `<div class="phand${active}"><div class="cards">${h.cards.map(cardHTML).join('')}</div><span class="tot ${cls}">${label}${h.bet === 2 ? ` · ${W.doubled}` : ''}${out ? ' · ' + RESULT[out][0] : ''}</span></div>`;
      }).join('');
    }
    const res = $('[data-result]');
    if (round?.finished) {
      const outs = round.outcomes;
      const main = outs.length === 1 ? RESULT[outs[0]] : [`${outs.filter((o) => RESULT[o][1] === 'win').length} ${W.of} ${outs.length} ${W.won}`, 'push'];
      res.textContent = main[0]; res.className = `result ${main[1]}`;
    } else { res.textContent = ''; res.className = 'result'; }
    const avail = round && !round.finished ? round.available() : new Set<Action>();
    root.querySelectorAll<HTMLButtonElement>('[data-a]').forEach((b) => (b.disabled = !avail.has(b.dataset.a as Action)));
    $<HTMLButtonElement>('[data-deal]').disabled = !!round && !round.finished;
  }

  function deal() {
    if (round && !round.finished) return;
    if (shoe.needsShuffle()) shoe.shuffle();
    $('[data-feedback]').hidden = true;
    round = new Round(shoe, rules);
    if (round.finished) { hands++; store.set('hands', hands); }
    render();
  }

  function act(a: Action) {
    if (!round || round.finished || !round.available().has(a)) return;
    const correct = round.correct();
    const key = round.key(), up = round.upcard;
    const ok = a === correct;
    total_++; if (ok) { right++; streak++; } else streak = 0;
    store.set('right', right); store.set('total', total_); store.set('streak', streak);
    const fb = $('[data-feedback]');
    fb.hidden = false;
    fb.className = `feedback ${ok ? 'ok' : 'ko'}`;
    const why = explain(key, up, correct, rules, LANG);
    fb.innerHTML = ok ? `<b>${W.good}: ${NAME[a]}.</b>${why}` : `<b>${W.was} ${NAME[correct]}.</b>${why}`;
    round.perform(a);
    if (round.finished) {
      hands++; store.set('hands', hands);
      if (!nudged && hands >= 20 && hands % 20 === 0) { nudged = true; $('[data-nhands]').textContent = String(hands); $('[data-nudge]').hidden = false; }
    }
    stats(); render();
  }

  root.querySelectorAll<HTMLButtonElement>('[data-a]').forEach((b) => b.addEventListener('click', () => act(b.dataset.a as Action)));
  $('[data-deal]').addEventListener('click', deal);
  $('[data-reset]').addEventListener('click', () => { right = total_ = streak = 0; ['right', 'total', 'streak'].forEach((k) => store.set(k, 0)); stats(); });
  $<HTMLSelectElement>('[data-rules]').addEventListener('change', (e) => {
    rulesKey = (e.target as HTMLSelectElement).value; store.set('rules', rulesKey);
    rules = presets[rulesKey]; shoe = new Shoe(rules.decks); round = null; $('[data-feedback]').hidden = true; render();
  });
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest('input, select, textarea')) return;
    if (e.key === ' ' || e.key === 'Enter') { if (!round || round.finished) { e.preventDefault(); deal(); } return; }
    const a = KEYS[e.key.toLowerCase()];
    if (a) act(a);
  });

  stats(); render();
</script>
