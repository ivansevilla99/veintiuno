---
import AppStoreButton from './AppStoreButton.astro';
import { ui, type Lang } from '../lib/site';
interface Props { lang: Lang; title?: string; text?: string; campaign?: string; moreHref?: string; moreText?: string }
const { lang, title, text, campaign, moreHref, moreText } = Astro.props;
const t = ui[lang];
---
<aside class="cta">
  <div>
    <h2>{title ?? t.ctaTitle}</h2>
    <p>{text ?? t.ctaText}</p>
    {moreHref && moreText && <p><a href={moreHref}>{moreText}</a></p>}
  </div>
  <AppStoreButton lang={lang} campaign={campaign} />
</aside>
