---
import { ui, campaignURL, type Lang } from '../lib/site';
interface Props { lang: Lang; campaign?: string }
const { lang, campaign = 'web' } = Astro.props;
const t = ui[lang];
// Each placement gets its own campaign so App Analytics shows which page brings installs.
const href = campaignURL(`${lang}-${campaign}`);
---
<a class="appstore" href={href} rel="noopener" data-campaign={campaign}>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M16.37 12.62c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.88 1.15 9.13.76 1.1 1.67 2.33 2.86 2.29 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.22.87-1.27 1.23-2.51 1.25-2.57-.03-.01-2.39-.92-2.4-3.66zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.01.08 2.05-.52 2.68-1.28z"/></svg>
  <span><small>{t.appStoreSmall}</small><b>{t.appStoreBig}</b></span>
</a>
