---
import CourseLesson from '../../../components/CourseLesson.astro';
import { courses } from '../../../lib/courses';

export function getStaticPaths() {
  return courses.fr.map((lesson, i) => ({ params: { slug: lesson.slug }, props: { i } }));
}
const { i } = Astro.props as { i: number };
---
<CourseLesson lang="fr" lessons={courses.fr} i={i} />
