---
import CourseLesson from '../../components/CourseLesson.astro';
import { courses } from '../../lib/courses';

export function getStaticPaths() {
  return courses.es.map((lesson, i) => ({ params: { slug: lesson.slug }, props: { i } }));
}
const { i } = Astro.props as { i: number };
---
<CourseLesson lang="es" lessons={courses.es} i={i} />
