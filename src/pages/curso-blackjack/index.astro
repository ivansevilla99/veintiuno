---
import Base from '../../layouts/Base.astro';
import AppCTA from '../../components/AppCTA.astro';
import { lessons } from '../../lib/course';
import { routes } from '../../lib/site';

const site = Astro.site!;
const total = lessons.reduce((a, l) => a + l.minutes, 0);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'Curso de blackjack gratis',
    description: 'Curso gratuito para aprender a jugar al blackjack: reglas, pagos, estrategia básica (pedir, plantarse, doblar, dividir, rendirse), elegir mesa y conteo de cartas.',
    inLanguage: 'es',
    isAccessibleForFree: true,
    provider: { '@type': 'Organization', name: 'Veintiuno', url: site.href },
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR', category: 'Free' },
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Online', courseWorkload: `PT${total}M` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: lessons.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.title, url: new URL(`/curso-blackjack/${l.slug}/`, site).href })),
  },
];
---
<Base lang="es" route="course" title="Curso de blackjack gratis: de cero a la estrategia básica" description={`Curso de blackjack gratis y online: 10 lecciones cortas (${total} minutos en total) con ejercicios, de las reglas y los pagos a la estrategia básica y el conteo de cartas.`} schema={schema}>
  <section class="hero" style="padding:56px 0 48px">
    <div class="container read">
      <span class="eyebrow">Curso gratis</span>
      <h1>Curso de blackjack</h1>
      <p class="lead">Diez lecciones cortas para pasar de no saber las reglas a jugar con la estrategia básica. Unos {total} minutos en total, con un ejercicio al final de cada lección. Sin registro y sin dinero real.</p>
      <div class="hero-actions"><a class="btn btn-gold" href={`/curso-blackjack/${lessons[0].slug}/`}>Empezar la lección 1</a></div>
    </div>
  </section>
  <div class="container read" style="padding-top:32px">
    <ol class="course-list">
      {lessons.map((l, i) => (
        <li>
          <a href={`/curso-blackjack/${l.slug}/`}>
            <span class="num">{i + 1}</span>
            <span><b>{l.title}</b><small>{l.summary}</small></span>
            <span class="min">{l.minutes} min</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="muted">¿Prefieres ir directo a una duda? Tienes la <a href={routes.strategy.es}>tabla de estrategia</a>, <a href={routes.whenDouble.es}>cuándo doblar</a>, <a href={routes.whenSplit.es}>cuándo dividir</a> y <a href={routes.hand16v10.es}>16 contra 10</a>.</p>
    <AppCTA lang="es" campaign="course" title="Del curso a la mesa" text="El curso te enseña qué hacer. La app de Veintiuno te lo hace practicar: te reparte manos, te corrige cada decisión y repasa tus errores hasta que te sale solo." />
  </div>
</Base>

<style>
  .course-list { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
  .course-list a { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; padding: 16px 18px; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; color: var(--text); transition: border-color .15s; }
  .course-list a:hover { border-color: rgba(237,194,92,.6); }
  .course-list .num { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: rgba(237,194,92,.14); color: var(--gold); font: 800 18px/1 var(--font-display); }
  .course-list b { display: block; font-size: 17px; }
  .course-list small { display: block; color: var(--muted); font-size: 14px; margin-top: 2px; line-height: 1.45; }
  .course-list .min { color: var(--muted); font-size: 13px; white-space: nowrap; }
</style>
