---
import Base from '../../../layouts/Base.astro';
import AppCTA from '../../../components/AppCTA.astro';
import { routes } from '../../../lib/site';
const groups = [
  { title: 'Inizia da qui', items: [
    ['course', 'Corso di blackjack gratis', '10 lezioni brevi con quiz, dalle regole al conteggio delle carte.'],
    ['simulator', 'Gioca a blackjack gratis', 'Un tavolo di allenamento che corregge ogni decisione, senza soldi e senza registrazione.'],
    ['howToPlay', 'Regole del blackjack', 'L’obiettivo, il valore delle carte, come si svolge una mano e i pagamenti.'],
  ] },
  { title: 'Giocare bene', items: [
    ['strategy', 'Tabella di strategia del blackjack', 'Interattiva, adattata alle regole del tuo tavolo, con il motivo di ogni casella.'],
    ['printable', 'Tabella di strategia in PDF', 'Tabelle da stampare per tavoli europei, di Las Vegas e spagnoli.'],
    ['whenDouble', 'Quando raddoppiare?', 'Ogni raddoppio, con il valore atteso di ogni situazione.'],
    ['whenSplit', 'Quando dividere?', 'Quali coppie dividere e contro quale carta del banco.'],
    ['hand16v10', '16 contro 10', 'La mano più temuta, in numeri.'],
    ['softHands', 'Mani soft (A-2…A-9)', 'Quando chiedere carta, raddoppiare o stare con un asso che vale 11.'],
    ['surrender', 'Quando arrendersi', 'Le poche mani in cui salvare metà puntata è la scelta migliore.'],
    ['insurance', 'Assicurazione ed even money', 'Perché non conviene quasi mai, con i calcoli.'],
    ['mistakes', 'Gli errori più comuni', 'Cosa costa di più al tavolo e come evitarlo.'],
    ['howToWin', 'Come vincere a blackjack', 'Cosa riduce davvero il vantaggio del banco e cosa è solo fumo.'],
    ['spain', 'Regole del blackjack in Spagna', 'Senza carta coperta, raddoppio solo su 9–11, niente resa: cosa cambia.'],
    ['macau', 'Blackjack a Macao', 'Resa anticipata e vantaggio del banco di circa lo 0,16%: cosa cambia.'],
    ['live', 'Blackjack live', 'Regole tipiche, strategia contro il 10 e perché contare serve a poco.'],
    ['app', 'La migliore app per imparare il blackjack', 'Perché un allenatore ti insegna qualcosa e un gioco da casinò no.'],
  ] },
  { title: 'Livello avanzato', items: [
    ['counting', 'Contare le carte', 'Hi-Lo, il conteggio reale e la realtà del conteggio, con esercizio.'],
    ['practiceCounting', 'Allenarsi a contare le carte', 'Un piano passo dopo passo e l’esercizio del mazzo intero.'],
    ['countingLegal', 'Contare le carte è illegale?', 'Cosa dice la legge in Spagna, Messico, Argentina e Stati Uniti.'],
  ] },
  { title: 'Dati', items: [
    ['dataBust', 'Probabilità che il banco sballi', 'Tabella esatta per carta scoperta, S17 e H17.'],
    ['dataRules', 'Vantaggio del banco per regole', 'Quanto ti costa ogni regola del tavolo.'],
    ['payout65', 'Blackjack 6:5 contro 3:2', 'Quanto ti costa davvero un tavolo che paga 6:5.'],
  ] },
] as const;
---
<Base lang="it" route="guides" title="Guide al blackjack: regole, strategia, conteggio" description="Tutte le guide al blackjack di Veintiuno: regole, strategia di base e tabella di strategia, le regole in Spagna e come contare le carte, spiegati con onestà.">
  <div class="container">
    <header class="article-head read" style="margin-left:0">
      <h1>Guide al blackjack</h1>
      <p class="lead">Tutto quello che ti serve per giocare bene, nell’ordine giusto: dalle regole alla strategia e, se vuoi, fino al conteggio delle carte.</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <div class="grid-2">{g.items.map(([key, title, text]) => <a class="card" href={routes[key].it}><h3>{title}</h3><p>{text}</p></a>)}</div>
      </section>
    ))}
    <AppCTA lang="it" campaign="guides" />
  </div>
</Base>
