---
import Base from '../../../layouts/Base.astro';
import AppCTA from '../../../components/AppCTA.astro';
import { routes } from '../../../lib/site';
const groups = [
  { title: 'まずはここから', items: [
    ['course', '無料のブラックジャック講座', 'ルールからカウンティングまで、小テスト付きの短いレッスン10回。'],
    ['simulator', '無料でブラックジャックを練習', 'すべての判断を正してくれる練習用テーブル。お金も登録も不要です。'],
    ['howToPlay', 'ブラックジャックのルール', '目的、カードの数え方、1ハンドの流れ、配当。'],
  ] },
  { title: '上手にプレイする', items: [
    ['strategy', 'ブラックジャックのストラテジー表', 'インタラクティブで、テーブルのルールに合わせて変わり、各マスの理由もわかります。'],
    ['printable', 'ストラテジー表のPDF', 'ヨーロッパ、ラスベガス、スペインのテーブル向けの印刷用の表。'],
    ['whenDouble', 'ダブルダウンするべき時', 'すべてのダブルダウンを、各場面の期待値付きで。'],
    ['whenSplit', 'スプリットするべき時', 'どのペアを、ディーラーのどのカードに対して分けるか。'],
    ['hand16v10', '16対10', 'いちばん嫌われるハンドを、数字で。'],
    ['softHands', 'ソフトハンドのプレイ方法', 'A-2〜A-9：ヒット、スタンド、ダブルダウンの使い分け。'],
    ['surrender', 'サレンダーすべき時', '賭け金の半分を捨てる方が得になる、数少ないハンド。'],
    ['mistakes', 'よくある間違い', 'テーブルでいちばん高くつく間違いと、その避け方。'],
    ['howToWin', 'ブラックジャックで勝てる？', 'ハウスエッジを本当に下げるものと、ただの誇大宣伝。'],
    ['spain', 'スペインのブラックジャックのルール', 'ホールカードなし、ダブルダウンは9〜11のみ、サレンダーなし：何が変わるか。'],
    ['app', 'ブラックジャックを学ぶおすすめアプリ', 'トレーナーは教えてくれて、カジノゲームは教えてくれない理由。'],
  ] },
  { title: 'テーブルとルール', items: [
    ['payout65', 'ブラックジャック6:5と3:2', '6:5で支払うテーブルが実際にいくら不利か。'],
    ['insurance', 'インシュランスとイーブンマネー', 'ほとんど得にならない理由を、数字で。'],
    ['macau', 'マカオのブラックジャック', 'マカオ・アジアのルールと、戦略がどう変わるか。'],
    ['live', 'ライブブラックジャック', '仕組み、確認すべきルール、カウンティングがほとんど役に立たない理由。'],
  ] },
  { title: '上級者向け', items: [
    ['counting', 'カードカウンティング', 'ハイロー、トゥルーカウント、カウンティングの現実を、練習付きで。'],
    ['practiceCounting', 'カードカウンティングの練習法', '段階を追ったプランと、1デックを数えきる練習。'],
    ['countingLegal', 'カードカウンティングは違法？', 'スペイン、メキシコ、アルゼンチン、アメリカの法律では。'],
  ] },
  { title: 'データ', items: [
    ['dataBust', 'ディーラーのバースト確率', 'アップカード別の正確な表（S17とH17）。'],
    ['dataRules', 'ルール別のハウスエッジ', '各テーブルルールがどれだけ不利になるか。'],
  ] },
] as const;
---
<Base lang="ja" route="guides" title="ブラックジャックのガイド：ルール、戦略、カウンティング" description="Veintiunoのブラックジャックガイド一覧。ルール、ベーシックストラテジーとストラテジー表、スペインのルール、カードカウンティングまで、正直にわかりやすく解説します。">
  <div class="container">
    <header class="article-head read" style="margin-left:0">
      <h1>ブラックジャックのガイド</h1>
      <p class="lead">上手にプレイするために必要なことを、正しい順番で。ルールから戦略へ、そして興味があればカードカウンティングまで。</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <div class="grid-2">{g.items.map(([key, title, text]) => <a class="card" href={routes[key].ja}><h3>{title}</h3><p>{text}</p></a>)}</div>
      </section>
    ))}
    <AppCTA lang="ja" campaign="guides" />
  </div>
</Base>
