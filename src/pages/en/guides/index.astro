---
import Base from '../../../layouts/Base.astro';
import AppCTA from '../../../components/AppCTA.astro';
import { routes } from '../../../lib/site';
const groups = [
  { title: 'Start here', items: [
    ['course', 'Free blackjack course', '10 short lessons with quizzes, from the rules to counting.'],
    ['simulator', 'Play blackjack free', 'A practice table that corrects every decision — no money, no sign-up.'],
    ['howToPlay', 'How to play blackjack', 'The goal, card values, how a hand plays out and what it pays.'],
    ['bj21', 'Blackjack vs 21', 'The differences, where the name comes from, and Spanish 21.'],
  ] },
  { title: 'Play well', items: [
    ['strategy', 'Basic strategy chart', 'Interactive, adjusted to your table’s rules, with the reason behind every cell.'],
    ['printable', 'Strategy chart PDF', 'Printable charts for Las Vegas, European and Spanish tables.'],
    ['whenDouble', 'When to double down', 'Every double, with the expected value of each.'],
    ['whenSplit', 'When to split', 'Which pairs to split and against what.'],
    ['hand16v10', '16 vs 10', 'The most dreaded hand, in numbers.'],
    ['howToWin', 'How to win at blackjack', 'What really reduces the house edge and what’s just hype.'],
    ['live', 'Live blackjack', 'Rules, variants and why counting barely helps.'],
    ['spain', 'Blackjack rules in Spain', 'No hole card, doubling on 9–11 only, no surrender: what changes.'],
    ['app', 'Best app to learn blackjack', 'Why a trainer teaches you and a casino game doesn’t.'],
  ] },
  { title: 'Advanced', items: [
    ['counting', 'How to count cards', 'Hi-Lo, the true count and the reality of counting, with a drill.'],
    ['practiceCounting', 'How to practice card counting', 'A step-by-step plan and the deck countdown drill.'],
    ['countingLegal', 'Is card counting illegal?', 'What the law says in Spain, Mexico, Argentina and the US.'],
    ['movie21', 'The 21 movie and the MIT team', 'What’s true and what’s Hollywood.'],
  ] },
  { title: 'Data', items: [
    ['dataBust', 'Dealer bust probability', 'Exact table by upcard, S17 and H17.'],
    ['dataRules', 'House edge by rules', 'What each table rule costs you.'],
  ] },
] as const;
---
<Base lang="en" route="guides" title="Blackjack Guides: Rules, Strategy and Card Counting · Veintiuno" description="All Veintiuno blackjack guides: rules, basic strategy, Spanish casino rules and an honest guide to card counting.">
  <div class="container">
    <header class="article-head read" style="margin-left:0">
      <h1>Blackjack guides</h1>
      <p class="lead">Everything you need to play well, in order: from the rules to strategy and, if you like, card counting.</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <div class="grid-2">{g.items.map(([key, title, text]) => <a class="card" href={routes[key].en}><h3>{title}</h3><p>{text}</p></a>)}</div>
      </section>
    ))}
    <AppCTA lang="en" campaign="guides" />
  </div>
</Base>
