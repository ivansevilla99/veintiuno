---
import Base from '../../layouts/Base.astro';
import AppCTA from '../../components/AppCTA.astro';
import { routes } from '../../lib/site';

const groups = [
  {
    title: 'Empezar desde cero',
    items: [
      ['course', 'Curso de blackjack gratis', '10 lecciones cortas con ejercicios, de las reglas al conteo.'],
      ['simulator', 'Jugar al blackjack gratis', 'Mesa de práctica con corrección de cada jugada, sin dinero ni registro.'],
      ['bj21', '¿Blackjack y 21 son lo mismo?', 'Diferencias, el origen del nombre y el Spanish 21.'],
      ['howToPlay', 'Cómo jugar al blackjack', 'Objetivo, valor de las cartas, cómo se desarrolla una mano y cuánto se paga.'],
      ['spain', 'Blackjack en los casinos de España', 'Sin carta oculta, doblar solo con 9–11 y sin rendición: qué cambia.'],
      ['macau', 'Blackjack en Macao y Asia', 'Rendición temprana y una de las ventajas de la casa más bajas.'],
    ],
  },
  {
    title: 'Jugar bien',
    items: [
      ['strategy', 'Tabla de estrategia básica', 'Interactiva, ajustada a las reglas de tu mesa, con la explicación de cada casilla.'],
      ['howToWin', '¿Cómo ganar al blackjack?', 'Qué reduce de verdad la ventaja de la casa y qué es humo.'],
      ['whenDouble', 'Cuándo doblar', 'Todas las dobladas, con el valor esperado de cada una.'],
      ['whenSplit', 'Cuándo dividir', 'Qué parejas separar y contra qué carta.'],
      ['hand16v10', '16 contra 10', 'La mano más temida, con números.'],
      ['softHands', 'Manos blandas', 'A-2 a A-9: cuándo pedir, doblar o plantarse.'],
      ['surrender', 'Cuándo rendirse', 'Las pocas manos en las que salvar media apuesta es lo mejor.'],
      ['insurance', 'El seguro en el blackjack', 'Por qué casi nunca conviene, ni siquiera el dinero par.'],
      ['mistakes', 'Los errores más comunes', 'Lo que más dinero cuesta en la mesa y cómo evitarlo.'],
      ['app', 'App para aprender blackjack', 'Por qué un entrenador enseña y un juego de casino no.'],
      ['printable', 'Tabla de estrategia en PDF', 'Para imprimir: España, europea y Las Vegas.'],
      ['live', 'Blackjack en vivo', 'Reglas, variantes y por qué contar apenas sirve.'],
    ],
  },
  {
    title: 'Avanzado',
    items: [
      ['counting', 'Cómo contar cartas', 'El sistema Hi-Lo, la cuenta verdadera y la realidad del conteo, con ejercicio.'],
      ['practiceCounting', 'Cómo practicar el conteo', 'Plan paso a paso y la cuenta atrás de la baraja.'],
      ['countingLegal', '¿Es ilegal contar cartas?', 'Qué dice la ley en España, México, Argentina y EE. UU.'],
      ['movie21', 'La película 21 y el equipo del MIT', 'Qué es verdad y qué es de Hollywood.'],
    ],
  },
  {
    title: 'Datos y probabilidades',
    items: [
      ['dataBust', 'Probabilidad de que el crupier se pase', 'Tabla exacta por carta visible, S17 y H17.'],
      ['dataRules', 'Cuánto cuesta cada regla', 'La ventaja de la casa según las reglas de la mesa.'],
      ['payout65', 'Blackjack 6:5 frente a 3:2', 'Cuánto te cuesta de verdad una mesa que paga 6:5.'],
    ],
  },
] as const;
---
<Base lang="es" route="guides" title="Guías de blackjack: reglas, estrategia y conteo · Veintiuno" description="Todas las guías de Veintiuno para aprender blackjack: reglas, estrategia básica, reglas de los casinos de España y conteo de cartas explicado con honestidad.">
  <div class="container">
    <header class="article-head read" style="margin-left:0">
      <h1>Guías de blackjack</h1>
      <p class="lead">Todo lo que necesitas para jugar bien, en orden: de las reglas a la estrategia y, si te apetece, al conteo.</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <div class="grid-2">
          {g.items.map(([key, title, text]) => (
            <a class="card" href={routes[key].es}><h3>{title}</h3><p>{text}</p></a>
          ))}
        </div>
      </section>
    ))}
    <AppCTA lang="es" campaign="guides" />
  </div>
</Base>
