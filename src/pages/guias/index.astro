---
import Base from '../../layouts/Base.astro';
import AppCTA from '../../components/AppCTA.astro';
import { routes } from '../../lib/site';

const groupIntro: Record<string, string> = {
  'Empezar desde cero': 'Reglas, valor de las cartas y un curso corto para jugar tu primera mano con seguridad.',
  'Jugar bien': 'La estrategia básica y cada decisión por separado (doblar, dividir, manos blandas, rendirse), más las reglas de las mesas de cada país.',
  'Avanzado': 'El conteo de cartas explicado con honestidad: cómo funciona, cómo practicarlo y qué dice la ley.',
  'Datos y probabilidades': 'Tablas exactas calculadas con el motor de Veintiuno, por si quieres ver de dónde salen los números.',
};
const faq = [
  { q: '¿Por dónde empiezo si nunca he jugado al blackjack?', a: 'Por cómo jugar al blackjack y por el curso gratis: reglas, valor de las cartas y pagos, sin tecnicismos. Después, la tabla de estrategia básica y la mesa de práctica gratis.' },
  { q: '¿Estas guías sirven para ganar dinero?', a: 'No. La estrategia básica reduce la ventaja de la casa al mínimo posible, pero no la elimina. Las guías te enseñan a tomar la decisión correcta y a perder lo menos posible, y te dicen con honestidad qué es humo.' },
  { q: '¿Hace falta aprender a contar cartas?', a: 'No. El conteo es un módulo avanzado y opcional, y solo tiene sentido cuando ya dominas la estrategia básica. Además, casi nunca funciona en mesas online o en vivo.' },
  { q: '¿Valen para las reglas de mi país?', a: 'Cada guía indica las reglas que asume (casino en España, Las Vegas, online) y la tabla de estrategia se puede ajustar regla a regla.' },
];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://veintiunoapp.com/' },
  { '@type': 'ListItem', position: 2, name: 'Guías de blackjack', item: 'https://veintiunoapp.com/guias/' },
] };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const groups = [
  {
    title: 'Empezar desde cero',
    items: [
      ['course', 'Curso de blackjack gratis', '10 lecciones cortas con ejercicios, de las reglas al conteo.'],
      ['simulator', 'Jugar al blackjack gratis', 'Mesa de práctica con corrección de cada jugada, sin dinero ni registro.'],
      ['bj21', '¿Blackjack y 21 son lo mismo?', 'Diferencias, el origen del nombre y el Spanish 21.'],
      ['howToPlay', 'Cómo jugar al blackjack', 'Objetivo, valor de las cartas, cómo se desarrolla una mano y cuánto se paga.'],
      ['spain', 'Blackjack en los casinos de España', 'Sin carta oculta, doblar solo con 9–11 y sin rendición: qué cambia.'],
      ['macau', 'Blackjack en Macao y Asia', 'Rendición temprana y una de las ventajas de la casa más bajas.'],
    ],
  },
  {
    title: 'Jugar bien',
    items: [
      ['strategy', 'Tabla de estrategia básica', 'Interactiva, ajustada a las reglas de tu mesa, con la explicación de cada casilla.'],
      ['howToWin', '¿Cómo ganar al blackjack?', 'Qué reduce de verdad la ventaja de la casa y qué es humo.'],
      ['whenDouble', 'Cuándo doblar', 'Todas las dobladas, con el valor esperado de cada una.'],
      ['whenSplit', 'Cuándo dividir', 'Qué parejas separar y contra qué carta.'],
      ['hand16v10', '16 contra 10', 'La mano más temida, con números.'],
      ['softHands', 'Manos blandas', 'A-2 a A-9: cuándo pedir, doblar o plantarse.'],
      ['surrender', 'Cuándo rendirse', 'Las pocas manos en las que salvar media apuesta es lo mejor.'],
      ['insurance', 'El seguro en el blackjack', 'Por qué casi nunca conviene, ni siquiera el dinero par.'],
      ['mistakes', 'Los errores más comunes', 'Lo que más dinero cuesta en la mesa y cómo evitarlo.'],
      ['app', 'App para aprender blackjack', 'Por qué un entrenador enseña y un juego de casino no.'],
      ['printable', 'Tabla de estrategia en PDF', 'Para imprimir: España, europea y Las Vegas.'],
      ['live', 'Blackjack en vivo', 'Reglas, variantes y por qué contar apenas sirve.'],
      ['sideBets', 'Apuestas laterales: 21+3 y Perfect Pairs', 'Cuánto se quedan de verdad, calculado por nosotros.'],
      ['aiDealers', 'Crupieres con IA', 'El blackjack en vivo con crupier digital: qué cambia y qué no.'],
      ['aiAdvice', '¿Te enseña ChatGPT a jugar al blackjack?', 'Dónde se equivoca la IA y un test de 12 manos.'],
    ],
  },
  {
    title: 'Avanzado',
    items: [
      ['counting', 'Cómo contar cartas', 'El sistema Hi-Lo, la cuenta verdadera y la realidad del conteo, con ejercicio.'],
      ['practiceCounting', 'Cómo practicar el conteo', 'Plan paso a paso y la cuenta atrás de la baraja.'],
      ['countingLegal', '¿Es ilegal contar cartas?', 'Qué dice la ley en España, México, Argentina y EE. UU.'],
      ['movie21', 'La película 21 y el equipo del MIT', 'Qué es verdad y qué es de Hollywood.'],
    ],
  },
  {
    title: 'Datos y probabilidades',
    items: [
      ['dataBust', 'Probabilidad de que el crupier se pase', 'Tabla exacta por carta visible, S17 y H17.'],
      ['dataRules', 'Cuánto cuesta cada regla', 'La ventaja de la casa según las reglas de la mesa.'],
      ['payout65', 'Blackjack 6:5 frente a 3:2', 'Cuánto te cuesta de verdad una mesa que paga 6:5.'],
      ['bettingSim', 'Simulador de Martingala', 'Prueba los sistemas de apuesta con manos reales: cuántas sesiones ganan y cuántas se arruinan.'],
      ['lossCalc', 'Calculadora de pérdidas', 'Cuánto cuesta jugar según tu apuesta, la mesa y cómo juegas.'],
    ],
  },
] as const;
---
<Base lang="es" route="guides" title="Guías de blackjack: reglas, estrategia y conteo · Veintiuno" description="Todas las guías de Veintiuno para aprender blackjack: reglas, estrategia básica, reglas de los casinos de España y conteo de cartas explicado con honestidad." schema={[crumbs, faqSchema]}>
  <div class="container">
    <header class="article-head read" style="margin-left:0">
      <h1>Guías de blackjack</h1>
      <p class="lead">Todo lo que necesitas para jugar bien, en orden: de las reglas a la estrategia y, si te apetece, al conteo.</p>
      <p>Las guías de Veintiuno están ordenadas para recorrerlas de arriba abajo. Si nunca has jugado, empieza por <a href={routes.howToPlay.es}>cómo jugar al blackjack</a> y el <a href={routes.course.es}>curso gratis</a>: las reglas, el valor de las cartas y los pagos, sin tecnicismos. Con eso claro, pasa a «Jugar bien»: la <a href={routes.strategy.es}>tabla de estrategia básica</a> es el centro de todo, y las guías de <a href={routes.whenDouble.es}>cuándo doblar</a>, <a href={routes.whenSplit.es}>cuándo dividir</a>, <a href={routes.softHands.es}>manos blandas</a>, <a href={routes.surrender.es}>cuándo rendirse</a> y <a href={routes.hand16v10.es}>16 contra 10</a> profundizan en las decisiones que más se fallan, con el valor esperado de cada opción.</p>
      <p>Las guías sobre mesas (<a href={routes.spain.es}>reglas de España</a>, <a href={routes.macau.es}>Macao</a>, <a href={routes.live.es}>blackjack en vivo</a>, <a href={routes.payout65.es}>6:5 frente a 3:2</a>) sirven para ajustar la estrategia a donde vayas a jugar. Si te preguntas si todo esto sirve para ganar dinero, <a href={routes.howToWin.es}>cómo ganar al blackjack</a> responde con honestidad: la estrategia reduce la ventaja de la casa, no la elimina.</p>
      <p>El grupo «Avanzado» es opcional: <a href={routes.counting.es}>contar cartas</a>, <a href={routes.practiceCounting.es}>cómo practicarlo</a> y <a href={routes.countingLegal.es}>si es ilegal</a>. Conviene no tocarlo hasta dominar la estrategia básica. Por último, «Datos y probabilidades» reúne las tablas calculadas con el motor de Veintiuno. Cada guía termina con enlaces a las siguientes y, si prefieres practicar en el móvil, con la <a href={routes.app.es}>app para iPhone y Mac</a>.</p>
    </header>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <p class="muted">{groupIntro[g.title]}</p>
        <div class="grid-2">
          {g.items.map(([key, title, text]) => (
            <a class="card" href={routes[key].es}><h3>{title}</h3><p>{text}</p></a>
          ))}
        </div>
      </section>
    ))}
    <section class="faq read" style="margin-left:0">
      <h2 id="faq">Preguntas frecuentes</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
    <AppCTA lang="es" campaign="guides" />
  </div>
</Base>
