---
import Base from './Base.astro';
import AppCTA from '../components/AppCTA.astro';
import { routes, ui, pathOf, linkOf, localeOf, type Lang, type RouteKey } from '../lib/site';
import { packs } from '../i18n';

export interface Faq { q: string; a: string }
interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;          // <title>
  h1: string;
  description: string;
  updated: string;        // ISO date
  readMinutes?: number;
  faq?: Faq[];
  related?: RouteKey[];
  cta?: { title?: string; text?: string };
  wide?: boolean;         // tool pages use the full container width
  extraSchema?: object[];
}
const { lang, route, title, h1, description, updated, readMinutes, faq = [], related = [], cta, wide = false, extraSchema = [] } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const url = new URL(pathOf(route, lang)!, site).href;
const date = new Date(updated);
const dateLabel = date.toLocaleDateString(localeOf(lang), { day: 'numeric', month: 'long', year: 'numeric' });

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description,
    inLanguage: lang,
    datePublished: updated,
    dateModified: updated,
    mainEntityOfPage: url,
    author: { '@type': 'Person', name: 'Iván Sevilla', url: new URL(routes.home[lang], site).href },
    publisher: { '@type': 'Organization', name: 'Veintiuno', logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site).href } },
    image: new URL('/og.png', site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: new URL(routes.home[lang], site).href },
      { '@type': 'ListItem', position: 2, name: h1, item: url },
    ],
  },
];
schema.push(...extraSchema);
if (faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}

const relatedLabels: Record<string, Partial<Record<Lang, [string, string]>> & { es: [string, string]; en: [string, string] }> = {
  strategy: { es: ['Tabla de estrategia básica', 'La tabla interactiva, ajustada a las reglas de tu mesa.'], en: ['Basic strategy chart', 'The interactive chart, adjusted to your table’s rules.'], de: ['Blackjack-Strategietabelle', 'Die interaktive Tabelle, angepasst an die Regeln deines Tisches.'], fr: ['Tableau de stratégie du blackjack', 'Le tableau interactif, ajusté aux règles de votre table.'] },
  howToPlay: { es: ['Cómo jugar al blackjack', 'Reglas, valores de las cartas y desarrollo de una mano.'], en: ['How to play blackjack', 'Rules, card values and how a hand unfolds.'], de: ['Blackjack-Regeln', 'Regeln, Kartenwerte und der Ablauf einer Hand.'], fr: ['Règles du blackjack', 'Règles, valeur des cartes et déroulement d’une main.'] },
  counting: { es: ['Contar cartas', 'El sistema Hi-Lo explicado con honestidad.'], en: ['Card counting', 'The Hi-Lo system, explained honestly.'], de: ['Karten zählen', 'Das Hi-Lo-System, ehrlich erklärt.'], fr: ['Compter les cartes', 'Le système Hi-Lo, expliqué honnêtement.'] },
  howToWin: { es: ['¿Se puede ganar al blackjack?', 'Qué se puede y qué no se puede conseguir de verdad.'], en: ['Can you win at blackjack?', 'What is and isn’t actually possible.'], de: ['Kann man beim Blackjack gewinnen?', 'Was wirklich möglich ist – und was nicht.'], fr: ['Peut-on gagner au blackjack ?', 'Ce qui est vraiment possible, et ce qui ne l’est pas.'] },
  guides: { es: ['Todas las guías', 'Todo el contenido de Veintiuno.'], en: ['All guides', 'Everything on Veintiuno.'], de: ['Alle Ratgeber', 'Alle Inhalte von Veintiuno.'], fr: ['Tous les guides', 'Tout le contenu de Veintiuno.'] },
  spain: { es: ['Blackjack en los casinos de España', 'Sin carta oculta y doblando solo con 9, 10 u 11: qué cambia.'], en: ['Blackjack rules in Spain', 'No hole card, doubling on 9–11 only: what changes.'], de: ['Blackjack-Regeln in Spanien', 'Ohne Hole Card, Verdoppeln nur mit 9–11: was sich ändert.'], fr: ['Règles du blackjack en Espagne', 'Sans carte cachée, doubler seulement avec 9–11 : ce qui change.'] },
  about: { es: ['Sobre Veintiuno', 'Quién hay detrás y de dónde salen las tablas.'], en: ['About Veintiuno', 'Who’s behind it and where the charts come from.'], de: ['Über Veintiuno', 'Wer dahintersteht und woher die Tabellen kommen.'], fr: ['À propos de Veintiuno', 'Qui est derrière et d’où viennent les tableaux.'] },
  responsible: { es: ['Juego responsable', 'Señales de alerta y dónde pedir ayuda.'], en: ['Responsible gambling', 'Warning signs and where to get help.'], de: ['Verantwortungsvolles Spielen', 'Warnsignale und wo du Hilfe findest.'], fr: ['Jeu responsable', 'Signaux d’alerte et où trouver de l’aide.'] },
  live: { es: ['Blackjack en vivo', 'Cómo funciona, qué reglas mirar y por qué contar apenas sirve.'], en: ['Live blackjack', 'How it works, which rules to check and why counting barely helps.'], de: ['Live-Blackjack', 'Wie es funktioniert, auf welche Regeln du achten solltest und warum Zählen kaum hilft.'], fr: ['Blackjack en direct', 'Comment ça marche, quelles règles vérifier et pourquoi compter ne sert presque à rien.'] },
  payout65: { es: ['Blackjack 6:5 frente a 3:2', 'Cuánto te cuesta de verdad una mesa que paga 6:5.'], en: ['Blackjack 6:5 vs 3:2', 'What a 6:5 table really costs you.'], de: ['Blackjack 6:5 gegen 3:2', 'Was dich ein 6:5-Tisch wirklich kostet.'], fr: ['Blackjack 6:5 contre 3:2', 'Ce que vous coûte vraiment une table qui paie 6:5.'] },
  insurance: { es: ['El seguro en el blackjack', 'Por qué casi nunca conviene, con los números.'], en: ['Blackjack insurance', 'Why it almost never pays, with the numbers.'], de: ['Die Versicherung beim Blackjack', 'Warum sie sich fast nie lohnt – mit Zahlen.'], fr: ['L’assurance au blackjack', 'Pourquoi elle ne vaut presque jamais le coup, chiffres à l’appui.'] },
  surrender: { es: ['Cuándo rendirse', 'Las pocas manos en las que salvar media apuesta es lo mejor.'], en: ['When to surrender', 'The few hands where saving half your bet is best.'], de: ['Wann aufgeben?', 'Die wenigen Hände, bei denen der halbe Einsatz das Beste ist.'], fr: ['Quand abandonner', 'Les rares mains où sauver la moitié de la mise est le mieux.'] },
  softHands: { es: ['Cómo jugar las manos blandas', 'A-2 a A-9: cuándo pedir, doblar o plantarse.'], en: ['How to play soft hands', 'A-2 to A-9: when to hit, double or stand.'], de: ['Soft Hands richtig spielen', 'A-2 bis A-9: wann Karte, Verdoppeln oder Halten.'], fr: ['Jouer les mains souples', 'A-2 à A-9 : quand tirer, doubler ou rester.'] },
  mistakes: { es: ['Los errores más comunes', 'Lo que más dinero cuesta en la mesa y cómo evitarlo.'], en: ['Most common blackjack mistakes', 'What costs the most at the table and how to avoid it.'], de: ['Die häufigsten Blackjack-Fehler', 'Was am Tisch am meisten kostet und wie du es vermeidest.'], fr: ['Les erreurs les plus courantes', 'Ce qui coûte le plus cher à table et comment l’éviter.'] },
  macau: { es: ['Blackjack en Macao', 'Las reglas de Macao y Asia, y cómo cambian la estrategia.'], en: ['Macau blackjack rules', 'The rules in Macau and Asia, and how they change strategy.'], de: ['Blackjack in Macau', 'Die Regeln in Macau und Asien und wie sie die Strategie ändern.'], fr: ['Le blackjack à Macao', 'Les règles de Macao et d’Asie, et ce qu’elles changent.'] },
  countingLegal: { es: ['¿Es ilegal contar cartas?', 'Qué dice la ley en España, México, Argentina y EE. UU.'], en: ['Is card counting illegal?', 'What the law says in Spain, Mexico, Argentina and the US.'], de: ['Ist Kartenzählen illegal?', 'Was in Deutschland, Österreich, der Schweiz und den USA gilt.'], fr: ['Compter les cartes est-il illégal ?', 'Ce que dit la loi en France, en Belgique, en Suisse et aux États-Unis.'] },
  printable: { es: ['Tabla de estrategia en PDF', 'Para imprimir: España y Las Vegas.'], en: ['Strategy chart PDF', 'Printable charts for Las Vegas, European and Spanish tables.'], de: ['Strategietabelle als PDF', 'Zum Ausdrucken: europäisch, Las Vegas und Spanien.'], fr: ['Tableau de stratégie en PDF', 'À imprimer : européen, Las Vegas et Espagne.'] },
  movie21: { es: ['La película 21 y el equipo del MIT', 'Qué es verdad y qué es de Hollywood.'], en: ['The 21 movie and the MIT team', 'What’s true and what’s Hollywood.'] },
  bj21: { es: ['¿Blackjack y 21 son lo mismo?', 'Diferencias entre el 21 casero y el blackjack de casino.'], en: ['Blackjack vs 21', 'How casino blackjack differs from home games of 21.'] },
  simulator: { es: ['Jugar al blackjack gratis', 'Mesa de práctica con corrección de cada jugada, sin dinero.'], en: ['Play blackjack free', 'A practice table that corrects every decision, no money involved.'], de: ['Blackjack kostenlos spielen', 'Übungstisch mit Korrektur jeder Entscheidung, ohne Geld.'], fr: ['Jouer au blackjack gratuitement', 'Table d’entraînement qui corrige chaque décision, sans argent.'] },
  course: { es: ['Curso de blackjack gratis', '10 lecciones cortas, de las reglas al conteo, con ejercicios.'], en: ['Free blackjack course', '10 short lessons with quizzes, from the rules to counting.'], de: ['Kostenloser Blackjack-Kurs', '10 kurze Lektionen mit Quiz, von den Regeln bis zum Zählen.'], fr: ['Cours de blackjack gratuit', '10 leçons courtes avec quiz, des règles au comptage.'] },
  hand16v10: { es: ['16 contra 10: ¿pedir o plantarse?', 'La mano más temida, con los números exactos.'], en: ['16 vs 10: hit or stand?', 'The most dreaded hand, with the exact numbers.'], de: ['16 gegen 10: ziehen oder stehen?', 'Die gefürchtetste Hand, mit exakten Zahlen.'], fr: ['16 contre 10 : tirer ou rester ?', 'La main la plus redoutée, avec les chiffres exacts.'] },
  whenDouble: { es: ['Cuándo doblar en el blackjack', 'Todas las manos en las que doblar gana dinero.'], en: ['When to double down', 'Every hand where doubling makes money.'], de: ['Wann verdoppeln?', 'Alle Hände, bei denen Verdoppeln Geld bringt.'], fr: ['Quand doubler ?', 'Toutes les mains où doubler rapporte.'] },
  whenSplit: { es: ['Cuándo dividir en el blackjack', 'Qué parejas separar y contra qué carta.'], en: ['When to split', 'Which pairs to split and against what.'], de: ['Wann splitten?', 'Welche Paare du teilst und gegen welche Karte.'], fr: ['Quand séparer ?', 'Quelles paires séparer, et contre quelle carte.'] },
  practiceCounting: { es: ['Cómo practicar el conteo de cartas', 'Un plan de ejercicios de menos a más.'], en: ['How to practice card counting', 'A step-by-step drill plan.'], de: ['Kartenzählen üben', 'Ein Übungsplan Schritt für Schritt.'], fr: ['S’entraîner à compter les cartes', 'Un plan d’exercices étape par étape.'] },
  app: { es: ['La mejor app para aprender blackjack', 'Qué tipo de app te enseña de verdad.'], en: ['Best app to learn blackjack', 'What kind of app actually teaches you.'], de: ['Die beste App, um Blackjack zu lernen', 'Welche Art von App dir wirklich etwas beibringt.'], fr: ['La meilleure app pour apprendre le blackjack', 'Quel type d’app vous apprend vraiment.'] },
  dataBust: { es: ['Probabilidad de que el crupier se pase', 'Tabla exacta por carta visible, S17 y H17.'], en: ['Dealer bust probability', 'Exact table by upcard, S17 and H17.'], de: ['Wie oft überkauft sich der Dealer?', 'Exakte Tabelle nach offener Karte, S17 und H17.'], fr: ['Probabilité que le croupier saute', 'Tableau exact par carte visible, S17 et H17.'] },
  dataRules: { es: ['Cuánto cuesta cada regla', 'La ventaja de la casa según las reglas de la mesa.'], en: ['House edge by rules', 'What each table rule costs you.'], de: ['Hausvorteil nach Regeln', 'Was dich jede Tischregel kostet.'], fr: ['Avantage de la maison selon les règles', 'Ce que vous coûte chaque règle de table.'] },
  data: { es: ['Datos y probabilidades', 'Todas las tablas calculadas con el motor de Veintiuno.'], en: ['Blackjack data', 'All tables computed with the Veintiuno engine.'], de: ['Blackjack-Daten', 'Alle Tabellen, berechnet mit der Veintiuno-Engine.'], fr: ['Données du blackjack', 'Tous les tableaux calculés avec le moteur de Veintiuno.'] },
};
---
<Base lang={lang} route={route} title={title} description={description} type="article" schema={schema}>
  <div class="container">
    <div class={wide ? '' : 'read'}>
      <header class="article-head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href={routes.home[lang]}>{t.breadcrumbHome}</a> / <span>{h1}</span></nav>
        <h1>{h1}</h1>
        <p class="meta">{t.updated}: <time datetime={updated}>{dateLabel}</time>{readMinutes ? ` · ${readMinutes} ${t.readTime}` : ''} · Iván Sevilla</p>
      </header>
      <slot name="top" />
    </div>
    <slot name="wide" />
    <div class="read prose">
      <slot />

      {faq.length > 0 && (
        <section class="faq">
          <h2 id="faq">{t.faq}</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p set:html={f.a} />
            </details>
          ))}
        </section>
      )}

      <AppCTA lang={lang} title={cta?.title} text={cta?.text} campaign={route} />

      {related.length > 0 && (
        <section>
          <h2>{t.related}</h2>
          <div class="grid-2">
            {related.map((r) => (
              <a class="card" href={linkOf(r, lang)}>
                <h3>{(relatedLabels[r][lang] ?? packs[lang]?.related[r] ?? relatedLabels[r].en)[0]}</h3>
                <p>{(relatedLabels[r][lang] ?? packs[lang]?.related[r] ?? relatedLabels[r].en)[1]}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
