---
import '../styles/global.css';
import { routes, ui, APP_ID, type Lang, type RouteKey } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page id in `routes`; drives canonical, hreflang and the language switch. */
  route?: RouteKey;
  /** Path for pages that only exist in one language (canonical only). */
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
}

const { lang, title, description, route, path, image = '/og.png', type = 'website', schema = [], noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const selfPath = route ? routes[route][lang] : (path ?? Astro.url.pathname);
const canonical = new URL(selfPath, site).href;
const alternates = route
  ? (Object.entries(routes[route]) as [Lang, string][]).map(([l, p]) => ({ lang: l, href: new URL(p, site).href }))
  : [];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherHref = route ? routes[route][otherLang] : routes.home[otherLang];
const home = routes.home[lang];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Veintiuno',
  url: site.href,
  logo: new URL('/icon-512.png', site).href,
  sameAs: [`https://apps.apple.com/app/id${APP_ID}`],
};
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === 'en')?.href} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#062a22" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Safari on iPhone shows a native "Open / Get" banner for the app. -->
  <meta name="apple-itunes-app" content={`app-id=${APP_ID}`} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Veintiuno" />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
</head>
<body>
  <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand" href={home} aria-label="Veintiuno">
        <img src="/icon-64.png" alt="" width="32" height="32" />
        <span>Veintiuno</span>
      </a>
      <nav class="main-nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
        {t.nav.map(([key, label]) => (
          <a href={routes[key][lang]} aria-current={route === key ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="lang" href={otherHref} hreflang={otherLang} lang={otherLang}>{t.otherLang}</a>
        <a class="btn btn-gold btn-small" href={`https://apps.apple.com/app/id${APP_ID}`} rel="noopener">{t.downloadShort}<span class="long">{t.downloadLong}</span></a>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="brand" href={home}><img src="/icon-64.png" alt="" width="28" height="28" /><span>Veintiuno</span></a>
          <p class="muted small">{t.responsible}</p>
        </div>
        <nav class="footer-links" aria-label={lang === 'es' ? 'Legal' : 'Legal'}>
          {t.nav.map(([key, label]) => <a href={routes[key][lang]}>{label}</a>)}
          {t.legal.map(([key, label]) => <a href={routes[key][lang]}>{label}</a>)}
        </nav>
      </div>
      <p class="muted small">© {new Date().getFullYear()} Veintiuno · Iván Sevilla</p>
    </div>
  </footer>
</body>
</html>
